<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Фон значка приложения — primary светлой темы; совпадение проверяет ThemeWindowTest -->
    <color name="ic_launcher_background">#348333</color>

    <!--
        Фон окна и системных панелей до первой отрисовки Compose. Совпадает с background
        светлой темы (core/ui/theme/Color.kt), чтобы при запуске не мелькал другой цвет;
        совпадение проверяет ThemeWindowTest. Тёмный вариант — values-night/colors.xml.
    -->
    <color name="window_background">#F9FAFB</color>

    <!--
        Уведомление с кнопками в шторке (ADR-0042) рисует система, без Compose, поэтому его цвета —
        ресурсы. Они повторяют роли светлой темы: shade_primary — primary (залитая кнопка идущего
        таймера и текстовые кнопки), shade_container — primaryContainer (кнопки старта и строки
        «Отменить»), shade_on_* — текст и иконки на них. Совпадение проверяет ThemeWindowTest.
    -->
    <color name="shade_primary">#348333</color>
    <color name="shade_on_primary">#FFFFFF</color>
    <color name="shade_container">#D5EFD1</color>
    <color name="shade_on_container">#0B3A0B</color>
</resources>
