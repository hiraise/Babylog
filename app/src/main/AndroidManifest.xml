<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Никаких permissions: приложение не ходит в интернет и работает только с локальными данными -->

    <!-- allowBackup=false: база не уходит в облачный автобэкап Google, перенос данных — только CSV-экспортом -->
    <application
        android:name=".App"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.BabyLog">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="uiMode">
            <!-- uiMode: смену темы (системной или выбранной в приложении) Activity принимает сама,
                 без пересоздания окна — иначе экран моргает (ADR-0017) -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Файл, куда системная камера кладёт снимок для фото ребёнка: приложению не нужно разрешение
             CAMERA, а камера получает доступ только к этому файлу (ADR-0023) -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.photos"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/photo_paths" />
        </provider>
    </application>

</manifest>
