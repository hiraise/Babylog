<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Приложение не ходит в интернет и работает только с локальными данными (ADR-0002). Разрешения —
         только для уведомления с кнопками в шторке, которое включают в меню (ADR-0042): показать его
         (Android 13+ спрашивает пользователя) и вернуть после перезагрузки телефона -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- allowBackup=false: база не уходит в облачный автобэкап Google. Перенос между телефонами средствами
         Android 12+ (D2D) этот флаг не выключает — и не нужно: дневник переносится вместе с фото, а копии
         базы лежат в no_backup/ и не переносятся (ADR-0033) -->
    <application
        android:name=".App"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.BabyLog">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="uiMode">
            <!-- uiMode: смену темы (системной или выбранной в приложении) Activity принимает сама,
                 без пересоздания окна — иначе экран моргает (ADR-0017) -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Кнопки уведомления в шторке (ADR-0042): не экспортирован — нажать их может только система
             по нашему PendingIntent -->
        <receiver
            android:name=".ShadeActionReceiver"
            android:exported="false" />
        <!-- Возвращает уведомление в шторке после перезагрузки и обновления приложения (ADR-0042) -->
        <receiver
            android:name=".ShadeBootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <!-- Файл, куда системная камера кладёт снимок для фото ребёнка: приложению не нужно разрешение
             CAMERA, а камера получает доступ только к этому файлу (ADR-0023) -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.photos"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/photo_paths" />
        </provider>
    </application>

</manifest>
