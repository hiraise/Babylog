opt_out_usage
default_platform(:android)

platform :android do
  desc "Загрузить AAB в закрытое тестирование Google Play"
  lane :play_closed do
    root = File.expand_path("..", __dir__)
    version = File.read(File.join(root, "app/build.gradle.kts"), encoding: "UTF-8")[/versionName = "([^"]+)"/, 1]
    supply(
      package_name: "com.hiraise.babylog",
      aab: File.join(root, "build/release/babylog-#{version}.aab"),
      track: "alpha",
      json_key: ENV.fetch("PLAY_JSON_KEY_PATH"),
      release_status: "completed",
      skip_upload_metadata: false,
      skip_upload_images: false,
      skip_upload_screenshots: true,
      skip_upload_changelogs: false
    )
  end
end

platform :ios do
  desc "Собрать IPA и загрузить его в TestFlight"
  lane :ios_testflight do
    root = File.expand_path("..", __dir__)
    team_id = File.read(File.join(root, "ios/Signing.xcconfig"), encoding: "UTF-8")[/DEVELOPMENT_TEAM = (\S+)/, 1]
    profile_name = ENV.fetch("IOS_PROVISIONING_PROFILE_NAME")
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_PRIVATE_KEY_BASE64"),
      is_key_content_base64: true
    )

    gym(
      project: File.join(root, "ios/BabyLog.xcodeproj"),
      scheme: "BabyLog",
      configuration: "Release",
      destination: "generic/platform=iOS",
      clean: true,
      archive_path: File.join(root, "build/ios/BabyLog.xcarchive"),
      output_directory: File.join(root, "build/ios"),
      output_name: "BabyLog",
      derived_data_path: File.join(root, "ios/build/DerivedData"),
      export_method: "app-store",
      export_team_id: team_id,
      export_options: {
        method: "app-store",
        teamID: team_id,
        provisioningProfiles: {
          "com.hiraise.babylog" => profile_name
        }
      },
      xcargs: "CODE_SIGN_STYLE=Manual CODE_SIGN_IDENTITY='Apple Distribution' DEVELOPMENT_TEAM=#{team_id} PROVISIONING_PROFILE_SPECIFIER='#{profile_name}'"
    )

    pilot(
      api_key: api_key,
      app_identifier: "com.hiraise.babylog",
      ipa: File.join(root, "build/ios/BabyLog.ipa"),
      skip_submission: true,
      skip_waiting_for_build_processing: true
    )
  end
end
